<section class="blog-comments">
    <h2 class="h4 blog-comments-title"><i class="bi bi-chat-square-text me-2"></i>{lang key='website/articles/comments-title'}<span class="blog-comments-count num-tabular">3</span></h2>
    <div class="blog-comments-embed" data-comments data-login-url="{link route='sign-in'}" data-register-url="{link route='sign-up'}">
        <ul class="blog-comment-list">
            <li class="blog-comment">
                <span class="blog-comment-avatar"><i class="bi bi-person"></i></span>
                <div class="blog-comment-body">
                    <div class="blog-comment-head">
                        <span class="blog-comment-name">Jordan Blake</span>
                        <span class="blog-comment-date num-tabular">June 25, 2026</span>
                    </div>
                    <p class="blog-comment-text">Great write-up. Switching to a caching layer and a CDN cut my load time in half. The image optimization section was especially useful.</p>
                    <div class="blog-comment-actions">
                        <button type="button" class="blog-comment-action blog-comment-helpful" data-action="comment-helpful" aria-pressed="false"><i class="bi bi-hand-thumbs-up me-1"></i>{lang key='website/articles/comment-helpful'} (<span data-role="helpful-count">12</span>)</button>
                        <button type="button" class="blog-comment-action" data-action="comment-reply"><i class="bi bi-reply me-1"></i>{lang key='website/articles/comment-reply'}</button>
                        <div class="dropdown blog-comment-mod">
                            <button class="btn btn-ghost btn-sm blog-comment-mod-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{lang key='website/articles/comment-mod-actions'}"><i class="bi bi-three-dots-vertical"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><button class="dropdown-item" type="button" data-action="mod-approve"><i class="bi bi-check2-circle"></i>{lang key='website/articles/comment-mod-approve'}</button></li>
                                <li><button class="dropdown-item" type="button" data-action="mod-edit"><i class="bi bi-pencil"></i>{lang key='website/articles/comment-mod-edit'}</button></li>
                                <li><button class="dropdown-item" type="button" data-action="mod-pin"><i class="bi bi-pin-angle"></i>{lang key='website/articles/comment-mod-pin'}</button></li>
                                <li><button class="dropdown-item" type="button" data-action="mod-spam"><i class="bi bi-shield-exclamation"></i>{lang key='website/articles/comment-mod-spam'}</button></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><button class="dropdown-item text-danger" type="button" data-action="mod-delete"><i class="bi bi-trash3"></i>{lang key='website/articles/comment-mod-delete'}</button></li>
                            </ul>
                        </div>
                    </div>
                    <ul class="blog-comment-list blog-comment-replies">
                        <li class="blog-comment">
                            <span class="blog-comment-avatar"><i class="bi bi-person"></i></span>
                            <div class="blog-comment-body">
                                <div class="blog-comment-head">
                                    <span class="blog-comment-name">Daniel Foster<span class="badge bg-primary-subtle text-primary-emphasis ms-2"><i class="bi bi-pencil-fill me-1"></i>{lang key='website/articles/comment-author'}</span></span>
                                    <span class="blog-comment-date num-tabular">June 25, 2026</span>
                                </div>
                                <p class="blog-comment-text">Thanks Jordan! A CDN really is the biggest single win for most sites. Glad it helped.</p>
                                <div class="blog-comment-actions">
                                    <button type="button" class="blog-comment-action blog-comment-helpful" data-action="comment-helpful" aria-pressed="false"><i class="bi bi-hand-thumbs-up me-1"></i>{lang key='website/articles/comment-helpful'} (<span data-role="helpful-count">4</span>)</button>
                                    <button type="button" class="blog-comment-action" data-action="comment-reply"><i class="bi bi-reply me-1"></i>{lang key='website/articles/comment-reply'}</button>
                                    <div class="dropdown blog-comment-mod">
                                        <button class="btn btn-ghost btn-sm blog-comment-mod-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{lang key='website/articles/comment-mod-actions'}"><i class="bi bi-three-dots-vertical"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><button class="dropdown-item" type="button" data-action="mod-approve"><i class="bi bi-check2-circle"></i>{lang key='website/articles/comment-mod-approve'}</button></li>
                                            <li><button class="dropdown-item" type="button" data-action="mod-edit"><i class="bi bi-pencil"></i>{lang key='website/articles/comment-mod-edit'}</button></li>
                                            <li><button class="dropdown-item" type="button" data-action="mod-pin"><i class="bi bi-pin-angle"></i>{lang key='website/articles/comment-mod-pin'}</button></li>
                                            <li><button class="dropdown-item" type="button" data-action="mod-spam"><i class="bi bi-shield-exclamation"></i>{lang key='website/articles/comment-mod-spam'}</button></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><button class="dropdown-item text-danger" type="button" data-action="mod-delete"><i class="bi bi-trash3"></i>{lang key='website/articles/comment-mod-delete'}</button></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
            </li>
            <li class="blog-comment">
                <span class="blog-comment-avatar"><i class="bi bi-person"></i></span>
                <div class="blog-comment-body">
                    <div class="blog-comment-head">
                        <span class="blog-comment-name">Priya Nair</span>
                        <span class="blog-comment-date num-tabular">June 26, 2026</span>
                    </div>
                    <p class="blog-comment-text">Would love a follow-up specifically on database optimization for high-traffic stores.</p>
                    <div class="blog-comment-actions">
                        <button type="button" class="blog-comment-action blog-comment-helpful" data-action="comment-helpful" aria-pressed="false"><i class="bi bi-hand-thumbs-up me-1"></i>{lang key='website/articles/comment-helpful'} (<span data-role="helpful-count">7</span>)</button>
                        <button type="button" class="blog-comment-action" data-action="comment-reply"><i class="bi bi-reply me-1"></i>{lang key='website/articles/comment-reply'}</button>
                        <div class="dropdown blog-comment-mod">
                            <button class="btn btn-ghost btn-sm blog-comment-mod-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{lang key='website/articles/comment-mod-actions'}"><i class="bi bi-three-dots-vertical"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><button class="dropdown-item" type="button" data-action="mod-approve"><i class="bi bi-check2-circle"></i>{lang key='website/articles/comment-mod-approve'}</button></li>
                                <li><button class="dropdown-item" type="button" data-action="mod-edit"><i class="bi bi-pencil"></i>{lang key='website/articles/comment-mod-edit'}</button></li>
                                <li><button class="dropdown-item" type="button" data-action="mod-pin"><i class="bi bi-pin-angle"></i>{lang key='website/articles/comment-mod-pin'}</button></li>
                                <li><button class="dropdown-item" type="button" data-action="mod-spam"><i class="bi bi-shield-exclamation"></i>{lang key='website/articles/comment-mod-spam'}</button></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><button class="dropdown-item text-danger" type="button" data-action="mod-delete"><i class="bi bi-trash3"></i>{lang key='website/articles/comment-mod-delete'}</button></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </li>
        </ul>

        <div class="blog-comment-empty basic-empty-state d-none" data-role="comment-empty">
            <i class="bi bi-chat-square-text" aria-hidden="true"></i>
            <p class="fw-semibold mb-1">{lang key='website/articles/comments-empty-title'}</p>
            <p class="fs-7 mb-0">{lang key='website/articles/comments-empty-text'}</p>
        </div>

        <div class="blog-comment-gate d-none" data-comment-state="login">
            <span class="blog-comment-gate-ico"><i class="bi bi-chat-square-text"></i></span>
            <div class="blog-comment-gate-main">
                <span class="blog-comment-gate-title">{lang key='website/articles/comments-gate-title'}</span>
                <p class="blog-comment-gate-text">{lang key='website/articles/comments-gate-login-text'}</p>
            </div>
            <div class="blog-comment-gate-actions">
                <a class="btn btn-soft btn-sm" href="{link route='sign-in'}"><i class="bi bi-box-arrow-in-right me-1"></i>{lang key='website/articles/comments-login'}</a>
                <a class="btn btn-primary btn-sm" href="{link route='sign-up'}"><i class="bi bi-person-plus me-1"></i>{lang key='website/articles/comments-signup'}</a>
            </div>
        </div>
        <div class="blog-comment-gate d-none" data-comment-state="closed">
            <span class="blog-comment-gate-ico"><i class="bi bi-lock-fill"></i></span>
            <div class="blog-comment-gate-main">
                <span class="blog-comment-gate-title">{lang key='website/articles/comments-closed-title'}</span>
                <p class="blog-comment-gate-text">{lang key='website/articles/comments-closed-text'}</p>
            </div>
        </div>
        <form class="blog-comment-form" data-blog-comment-form data-comment-state="open" novalidate>
            <span class="blog-comment-avatar"><i class="bi bi-person"></i></span>
            <div class="blog-comment-compose">
                <div class="blog-comment-identity">
                    <label class="blog-comment-identity-label" for="blog-comment-as">{lang key='website/articles/comment-as'}</label>
                    <select class="form-select form-select-sm blog-comment-identity-select" id="blog-comment-as" data-role="comment-identity">
                        <option value="full" data-name="Alex Morgan" selected>Alex Morgan</option>
                        <option value="initial" data-name="Alex M.">Alex M.</option>
                        <option value="staff" data-name="Support Team" data-staff="1">Support Team</option>
                    </select>
                </div>
                <label for="blog-comment-text" class="visually-hidden">{lang key='website/articles/comment-add'}</label>
                <textarea class="form-control" id="blog-comment-text" rows="3" placeholder="{lang key='website/articles/comment-placeholder'}" data-role="comment-input"></textarea>
                <div class="blog-comment-notice" data-role="comment-notice" role="status" aria-live="polite">
                    <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                    <span>{lang key='website/articles/comment-blocked'}</span>
                </div>
                <div class="blog-comment-form-foot">
                    <div class="captcha-slot" data-captcha>
                        <div class="captcha-mock captcha-mock-checkbox">
                            <span class="form-check mb-0 d-flex align-items-center gap-2">
                                <input class="form-check-input" type="checkbox" id="blog-comment-captcha">
                                <label class="form-check-label fs-7" for="blog-comment-captcha">I am human</label>
                            </span>
                            <span class="fs-9 text-body-secondary"><i class="bi bi-shield-check me-1"></i>CAPTCHA</span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm ms-sm-auto"><i class="bi bi-send me-1"></i>{lang key='website/articles/comment-post'}</button>
                </div>
                <small class="blog-comment-form-note fs-7 text-body-secondary">{lang key='website/articles/comment-note'}</small>
            </div>
        </form>
    </div>
</section>
